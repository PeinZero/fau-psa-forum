# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin used for auth redirects, e.g. http://localhost:3000 or https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public). Use Cloudflare's test key 1x00000000000000000000AA on localhost and previews.
# The secret key goes only into Supabase > Authentication > Bot and Abuse Protection. Leave empty to skip the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
