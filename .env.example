# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin used for auth redirects, e.g. http://localhost:3000 or https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public). Use Cloudflare's test key 1x00000000000000000000AA on localhost and previews.
# The secret key goes only into Supabase > Authentication > Bot and Abuse Protection. Leave empty to skip the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Thread images. Leave all five empty to hide image uploads (CI and most local work).
# Address of the media Worker that serves images, e.g. https://psa-forum-media-dev.<account>.workers.dev
NEXT_PUBLIC_MEDIA_URL=
# Backblaze bucket the server uploads to, and its region from the S3 endpoint (e.g. eu-central-003).
# Locally and in Vercel Preview use the -dev bucket and its upload key; the live key goes only into Production.
MEDIA_B2_REGION=
MEDIA_B2_BUCKET=
MEDIA_B2_KEY_ID=
MEDIA_B2_APPLICATION_KEY=
