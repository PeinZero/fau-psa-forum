{
  "name": "psa-intro-film",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prestudio": "npm run score",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning 'tests/*.test.ts'",
    "score": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/score.ts",
    "captions": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/captions.ts ../public/video/intro.en.vtt",
    "stills": "node scripts/stills.mjs",
    "prerender": "npm run score",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/tailwind-v4": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "lucide-react": "1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.2.0",
    "typescript": "5.9.3"
  }
}
